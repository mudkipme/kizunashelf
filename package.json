{
  "name": "kizunashelf",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "cargo run -p kizunashelf --bin kizunashelf-api",
    "dev:desktop": "pnpm --filter @kizunashelf/desktop tauri dev",
    "dev:web": "pnpm --filter @kizunashelf/web dev",
    "build": "pnpm contract:generate && pnpm -r build && cargo build -p kizunashelf",
    "build:desktop": "pnpm --filter @kizunashelf/desktop tauri build",
    "lint": "oxlint apps/web/src apps/web/vite.config.ts packages/api-contract/src/index.ts packages/api-contract/orval.config.mjs --max-warnings=0",
    "typecheck": "pnpm -r typecheck && cargo check -p kizunashelf",
    "typecheck:desktop": "cargo check -p kizunashelf-desktop",
    "test": "cargo test -p kizunashelf",
    "contract:generate": "pnpm --filter @kizunashelf/api-contract generate",
    "serve": "cargo run -p kizunashelf --bin kizunashelf-api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "orval": "^8.17.0",
    "oxlint": "^1.70.0",
    "typescript": "^5.9.3"
  }
}
