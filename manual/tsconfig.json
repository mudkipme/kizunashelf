{
  // Inlined from @docusaurus/tsconfig: that preset still sets "baseUrl",
  // which TypeScript 7 removed (TS5102). Once Docusaurus drops it, this can
  // go back to `"extends": "@docusaurus/tsconfig"`.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
