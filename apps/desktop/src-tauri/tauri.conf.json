{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KizunaShelf",
  "version": "1.0.0",
  "identifier": "me.mudkip.kizunashelf-desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @kizunashelf/web dev",
    "beforeBuildCommand": "pnpm --filter @kizunashelf/web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "KizunaShelf",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
