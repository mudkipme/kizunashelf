// Bundled default provider credentials — REAL KEYS LIVE HERE, NEVER COMMIT.
//
// Copy this file to `values.rs` in this directory and fill in your keys. That
// filename is gitignored, and `crates/kizunashelf/build.rs` detects it
// automatically so the crate builds identically with or without it.
//
// You can also supply any of these at compile time via
// `KIZUNASHELF_BUNDLED_<UPPER_KEY>` environment variables (e.g.
// `KIZUNASHELF_BUNDLED_TMDB_API_KEY` in GitHub Actions); non-empty env vars
// take precedence over this file.
//
// At runtime, a user-configured credential (runtime `KIZUNASHELF_*` env var on
// web, or OS keychain entry on desktop/iOS) always overrides a bundled default,
// and bundled values are never written to the keychain or echoed back by the
// credentials editor.

use crate::secrets::{
    SECRET_BGG_API_TOKEN, SECRET_DISCOGS_CONSUMER_KEY, SECRET_DISCOGS_CONSUMER_SECRET,
    SECRET_GOOGLE_BOOKS_API_KEY, SECRET_IGDB_CLIENT_ID, SECRET_IGDB_CLIENT_SECRET,
    SECRET_MAL_CLIENT_ID, SECRET_TMDB_API_KEY, SECRET_TRAKT_CLIENT_ID, SECRET_TVDB_API_KEY,
};

pub(super) const VALUES: &[(&str, &str)] = &[
    // App identities — safe to bundle: read-only catalog access billed to the
    // app, no user account behind them.
    (SECRET_TMDB_API_KEY, ""),
    (SECRET_TVDB_API_KEY, ""), // the project key; NEVER a user's `tvdb_pin`
    (SECRET_MAL_CLIENT_ID, ""),
    (SECRET_IGDB_CLIENT_ID, ""),
    (SECRET_IGDB_CLIENT_SECRET, ""),
    // BGG XML API application token (register the app once at
    // boardgamegeek.com/using_the_xml_api — 401 without it).
    (SECRET_BGG_API_TOKEN, ""),
    // Discogs: the app consumer pair ONLY — a personal access token
    // (`discogs_token`) authenticates as its owner's account and must never ship
    // in the binary. A user-entered token still wins over these at runtime.
    // Discogs throttles per source IP, so a bundled pair scales fine.
    (SECRET_DISCOGS_CONSUMER_KEY, ""),
    (SECRET_DISCOGS_CONSUMER_SECRET, ""),
    // Google Books: an app identity, but the GCP project quota is shared by
    // every install of this build — restrict the key to the Books API and watch
    // usage.
    (SECRET_GOOGLE_BOOKS_API_KEY, ""),
    // Trakt: application client ID (`trakt-api-key`) for reading public profiles
    // during batch import.
    (SECRET_TRAKT_CLIENT_ID, ""),

    // NOT bundleable (rejected by the core allowlist) — per-user entry only:
    // - `hardcover_api_key`: Bearer token for its owner's Hardcover account
    //   (the API can read AND mutate that account's data).
    // - `comicvine_api_key`: read-only but rate-limited per key
    //   (~200 requests/resource/hour) — one shared key would throttle every
    //   install and risks a ban.
    // - `steam_api_key`: per-user Steam Web API key.
];
